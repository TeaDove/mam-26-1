</edge>
<edge source="DEFORMATION BAND" target="GRAIN-BOUNDARY AREA">
  <data key="d6">6.0</data>
  <data key="d7">The formation of deformation bands increases the grain-boundary area, correlating grain microstructure with mechanical properties</data>
</edge>
<edge source="DEFORMATION BAND" target="GAMMA-GRAIN">
