</edge>
<edge source="ACICULAR FERRITE" target="FINE-GRAINED POLYGONAL FERRITE">
  <data key="d6">7.0</data>
  <data key="d7">The relationship describes how increasing fine-grained polygonal ferrite can enhance overall strength while impacting the volume fraction of acicular ferrite, thus influencing toughness.</data>
</edge>
<edge source="TEXTURE DEVELOPMENT" target="TEXTURE INTENSITY">
  <data key="d6">7.0</data>
