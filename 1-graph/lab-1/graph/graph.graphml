</edge>
<edge source="T. TANAKA" target="I. KOZASU">
  <data key="d6">7.0</data>
  <data key="d7">I. Kozasu has co-authored works with T. Tanaka on the hot deformation of steels</data>
</edge>
<edge source="T. TANAKA" target="UNION CARBIDE CORPORATION">
  <data key="d6">5.0</data>
  <data key="d7">T. Tanaka's research has been published in context with Union Carbide Corporation, contributing to their studies in metallurgy</data>
</edge>
<edge source="T. TANAKA" target="THE IRON AND STEEL INSTITUTE OF JAPAN">
  <data key="d6">6.0</data>
  <data key="d7">Publications by T. Tanaka have been featured in the Iron and Steel Institute, indicating a strong relationship in metallurgy research</data>
</edge>
<edge source="T. TANAKA" target="METALLURGICAL SOCIETY OF AIME">
  <data key="d6">6.0</data>
  <data key="d7">T. Tanaka has published research under the Metallurgical Society of AIME regarding the processing of low-carbon steel</data>
</edge>
<edge source="T. TANAKA" target="CONTROLLED ROLLING OF STEEL">
  <data key="d6">1.0</data>
  <data key="d7">T. Tanaka has studied the implications of controlled rolling processes on steel microstructure</data>
</edge>
<edge source="T. TANAKA" target="Y. SAITO">
  <data key="d6">7.0</data>
