<edge source="Γ-GRAIN STRUCTURE" target="Α-MATRIX">
  <data key="d6">8.0</data>
  <data key="d7">The transformation from the γ-grain structure to the α-matrix in steel is a crucial phase change that affects the overall mechanical properties.</data>
</edge>
<edge source="NB" target="C-MN STEEL">
